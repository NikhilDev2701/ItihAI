# ==============================================================================
# Git Ignore Rules for ItihAI Full-Stack Platform
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Environment Variables & Secrets
.env
.env.local
.env.*.local
*.env

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Database Files
*.sqlite3
*.db
*.psql_dump

# Logs & Diagnostics
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/

# Frontend Builds & Dependencies
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.cache/
node_modules/
dist/
build/

# IDE & Editor Configurations
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Test & Coverage
.coverage
htmlcov/
.pytest_cache/

# Temporary / Scratch files
scratch/
tmp/
*.tmp
# Workspace test files
test.txt
workspace-check.txt